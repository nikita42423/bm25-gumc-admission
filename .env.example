# Скопируйте в .env и заполните. .env в Git не коммитится.

# yandex — YandexGPT через API Yandex Cloud; ollama — локальная модель
LLM_PROVIDER=yandex

# Сервисный аккаунт с ролью ai.languageModels.user → «Создать API-ключ» → секретный ключ
YANDEX_API_KEY=
# id каталога: консоль Yandex Cloud → каталог → «Обзор», строка вида b1g...
YANDEX_FOLDER_ID=
# yandexgpt/latest (Pro) или yandexgpt-lite/latest (дешевле и быстрее)
YANDEX_MODEL=yandexgpt/latest

# Запасной вариант — Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
