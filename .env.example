# Скопируйте в .env и заполните. .env в Git не коммитится.

# Порядок LLM: первая — основная, следующие — запасные. Если не ответит ни одна,
# пользователь увидит найденные фрагменты документов без сгенерированного ответа.
LLM_PROVIDERS=ollama,yandex

# Ollama (локально): ollama pull qwen3.5:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Сколько секунд ждать ответа, прежде чем перейти к запасной LLM
OLLAMA_TIMEOUT=90

# YandexGPT: сервисный аккаунт с ролью ai.languageModels.user → «Создать API-ключ»
YANDEX_API_KEY=
# id каталога: консоль Yandex Cloud → каталог → «Обзор», строка вида b1g...
YANDEX_FOLDER_ID=
# yandexgpt/latest (Pro) или yandexgpt-lite/latest (дешевле и быстрее)
YANDEX_MODEL=yandexgpt/latest
